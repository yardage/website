---
import { type Locale, t } from '../lib/i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'fr' } = Astro.props;
const copy = t(locale);
const form = copy.form;

/**
 * Remplacez YOUR_FORM_ID par votre identifiant Formspree
 * (https://formspree.io → New Form → endpoint https://formspree.io/f/xxxx)
 */
const formspreeEndpoint = import.meta.env.PUBLIC_FORMSPREE_ENDPOINT || 'https://formspree.io/f/YOUR_FORM_ID';

const fieldClass =
  'mt-2 w-full rounded-sm border border-mist bg-paper px-3 py-3 text-sm text-ink outline-none transition placeholder:text-ink-soft/50 focus:border-green-mid';
---

<form
  id="devis-form"
  action={formspreeEndpoint}
  method="POST"
  class="space-y-5"
  data-msg-unconfigured={form.unconfigured}
  data-msg-success={form.success}
  data-msg-error={form.error}
  data-prefill-quote={form.prefillQuote}
  data-prefill-sample={form.prefillSample}
  data-subject-quote={form.subjectQuote}
  data-subject-sample={form.subjectSample}
>
  <input type="hidden" name="_subject" id="form-subject" value={form.subjectQuote} />
  <input type="text" name="_gotcha" class="hidden" tabindex="-1" autocomplete="off" />

  <div class="grid gap-5 md:grid-cols-2">
    <label class="block">
      <span class="text-sm font-medium text-ink">{form.name}</span>
      <input type="text" name="name" required class={fieldClass} autocomplete="name" />
    </label>
    <label class="block">
      <span class="text-sm font-medium text-ink">{form.email}</span>
      <input type="email" name="email" required class={fieldClass} autocomplete="email" />
    </label>
  </div>

  <div class="grid gap-5 md:grid-cols-2">
    <label class="block">
      <span class="text-sm font-medium text-ink">{form.club}</span>
      <input type="text" name="club" required class={fieldClass} />
    </label>
    <label class="block">
      <span class="text-sm font-medium text-ink">{form.volume}</span>
      <select name="volume" id="form-volume" class={fieldClass}>
        <option value="">{form.optVolumePlaceholder}</option>
        <option value="<500">{form.optLt500}</option>
        <option value="500">{form.opt500}</option>
        <option value="1000">{form.opt1000}</option>
        <option value=">1000">{form.optGt1000}</option>
      </select>
    </label>
  </div>

  <label class="block">
    <span class="text-sm font-medium text-ink">{form.message}</span>
    <textarea
      name="message"
      id="form-message"
      rows="7"
      required
      class={fieldClass}
      placeholder={form.placeholder}
    ></textarea>
  </label>

  <button
    type="submit"
    class="rounded-sm bg-white px-5 py-3 text-sm font-semibold text-brand transition hover:bg-ink disabled:opacity-60"
  >
    {form.submit}
  </button>

  <p id="form-status" class="hidden text-sm" role="status" aria-live="polite"></p>
</form>

<script>
  const form = document.getElementById('devis-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');
  const messageField = document.getElementById('form-message') as HTMLTextAreaElement | null;
  const subjectField = document.getElementById('form-subject') as HTMLInputElement | null;
  const volumeField = document.getElementById('form-volume') as HTMLSelectElement | null;

  const applyIntentPrefill = () => {
    if (!form || !messageField || !subjectField) return;

    const params = new URLSearchParams(window.location.search);
    const hash = window.location.hash.replace(/^#/, '');
    const intent = (params.get('intent') || hash || '').toLowerCase();

    const isSample =
      intent === 'exemplaire' || intent === 'sample' || intent === 'exemple';
    const isQuote = intent === 'devis' || intent === 'quote';

    if (!isSample && !isQuote) return;
    // Don't overwrite if the visitor already typed something
    if (messageField.value.trim().length > 0) return;

    if (isSample) {
      messageField.value = form.dataset.prefillSample ?? '';
      subjectField.value = form.dataset.subjectSample ?? subjectField.value;
      if (volumeField) volumeField.value = '';
    } else {
      messageField.value = form.dataset.prefillQuote ?? '';
      subjectField.value = form.dataset.subjectQuote ?? subjectField.value;
    }
  };

  applyIntentPrefill();

  form?.addEventListener('submit', async (event) => {
    const action = form.getAttribute('action') || '';
    const msgUnconfigured = form.dataset.msgUnconfigured ?? '';
    const msgSuccess = form.dataset.msgSuccess ?? '';
    const msgError = form.dataset.msgError ?? '';

    if (action.includes('YOUR_FORM_ID')) {
      event.preventDefault();
      if (status) {
        status.classList.remove('hidden', 'text-green-mid');
        status.classList.add('text-ink-soft');
        status.textContent = msgUnconfigured;
      }
      return;
    }

    event.preventDefault();
    const button = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    if (button) button.disabled = true;

    try {
      const response = await fetch(action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });

      if (response.ok) {
        form.reset();
        if (subjectField) subjectField.value = form.dataset.subjectQuote ?? '';
        if (status) {
          status.classList.remove('hidden', 'text-ink-soft');
          status.classList.add('text-green-mid');
          status.textContent = msgSuccess;
        }
      } else {
        throw new Error('Form error');
      }
    } catch {
      if (status) {
        status.classList.remove('hidden', 'text-green-mid');
        status.classList.add('text-ink-soft');
        status.textContent = msgError;
      }
    } finally {
      if (button) button.disabled = false;
    }
  });
</script>
