---
/** The contact page, shared by `/contact/` and `/en/contact/`: contact details and the quote form. */
import { Mail, Phone } from '@lucide/astro';
import {
  CONTACT_EMAIL,
  CONTACT_PHONE,
  CONTACT_PHONE_HREF,
  absoluteUrl,
  getLocale,
  t,
} from '../i18n';
import Base from '../layouts/Base.astro';
import { breadcrumbJsonLd } from '../lib/schema';
import { socialLinks } from '../lib/social';
import ContactForm from './ContactForm.astro';
import Footer from './Footer.astro';
import Header from './Header.astro';
import PageHero from './PageHero.astro';

const locale = getLocale(Astro.currentLocale);
const copy = t(locale);
const meta = copy.pages.contact;
---

<Base
  title={meta.title}
  description={meta.description}
  jsonLd={[
    breadcrumbJsonLd([
      { name: copy.breadcrumbHome, url: absoluteUrl(locale, 'home') },
      { name: copy.nav.contact, url: absoluteUrl(locale, 'contact') },
    ]),
  ]}
>
  <Header />
  <main id="main">
    <PageHero eyebrow={meta.eyebrow} title={meta.heading} text={meta.lead} />

    <div class="mx-auto grid max-w-6xl items-start gap-6 px-5 py-14 sm:py-20 md:px-6 lg:grid-cols-[0.8fr_1.2fr]">
      <section class="rounded-xl border border-border bg-card p-6 sm:p-8" aria-labelledby="details-title">
        <h2 id="details-title" class="text-3xl tracking-tight">{meta.details}</h2>
        <ul class="mt-6 space-y-5">
          <li>
            <p class="text-xs font-medium tracking-[0.14em] text-muted-foreground uppercase">{meta.email}</p>
            <a href={`mailto:${CONTACT_EMAIL}`} class="mt-1 inline-flex items-center gap-2 font-medium text-primary hover:underline">
              <Mail class="size-4" aria-hidden="true" />
              {CONTACT_EMAIL}
            </a>
          </li>
          <li>
            <p class="text-xs font-medium tracking-[0.14em] text-muted-foreground uppercase">{meta.phone}</p>
            <a href={CONTACT_PHONE_HREF} class="mt-1 inline-flex items-center gap-2 font-medium text-primary hover:underline">
              <Phone class="size-4" aria-hidden="true" />
              {CONTACT_PHONE}
            </a>
          </li>
        </ul>

        <div class="mt-8 border-t border-border pt-6">
          <p class="text-xs font-medium tracking-[0.14em] text-muted-foreground uppercase">{meta.social}</p>
          <ul class="mt-3 grid gap-2 sm:grid-cols-2 lg:grid-cols-1">
            {
              socialLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="inline-flex items-center gap-2.5 text-sm font-medium hover:text-primary"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <svg class="size-4 shrink-0 text-primary" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d={link.path} />
                    </svg>
                    {link.name}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section class="rounded-xl border border-border bg-card p-6 sm:p-8" aria-labelledby="form-title">
        <h2 id="form-title" class="text-3xl tracking-tight">{meta.formTitle}</h2>
        <p class="mt-2 text-sm text-muted-foreground">{meta.formText}</p>
        <div class="mt-6">
          <ContactForm locale={locale} />
        </div>
      </section>
    </div>
  </main>
  <Footer />
</Base>
