---
import { ArrowRight } from '@lucide/astro';
import { getLocale, localePath, t } from '../i18n';

interface Props {
  eyebrow: string;
  title: string;
  text: string;
  /** Optional second link next to the quote button. */
  secondary?: { href: string; label: string };
}

const { eyebrow, title, text, secondary } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const copy = t(locale);
---

<section class="relative overflow-hidden" aria-labelledby="cta-title">
  <div class="mesh absolute inset-0"></div>
  <div class="relative mx-auto max-w-6xl px-5 py-16 sm:py-20 md:px-6">
    <div class="rounded-2xl bg-primary px-6 py-12 text-primary-foreground sm:px-12 sm:py-16">
      <p class="text-xs font-medium tracking-[0.14em] uppercase opacity-80">{eyebrow}</p>
      <h2 id="cta-title" class="mt-3 max-w-xl text-4xl tracking-tight text-balance sm:text-5xl">{title}</h2>
      <p class="mt-4 max-w-xl text-pretty opacity-90">{text}</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a
          href={localePath(locale, 'contact', '?intent=devis')}
          class="inline-flex items-center justify-center gap-2 rounded-lg bg-background px-5 py-3 text-sm font-medium text-foreground transition hover:opacity-90"
        >
          {copy.ctaQuote}
          <ArrowRight class="size-4" aria-hidden="true" />
        </a>
        {
          secondary && (
            <a
              href={secondary.href}
              class="inline-flex items-center justify-center rounded-lg border border-current/30 px-5 py-3 text-sm font-medium transition hover:bg-background/10"
            >
              {secondary.label}
            </a>
          )
        }
      </div>
    </div>
  </div>
</section>
