---
import { ArrowRight } from '@lucide/astro';
import FaqList from './FaqList.astro';

interface Props {
  eyebrow: string;
  title: string;
  items: readonly { q: string; a: string }[];
  /** Optional link under the list (e.g. to the full FAQ page). */
  more?: { href: string; label: string };
  id?: string;
}

const { eyebrow, title, items, more, id = 'faq' } = Astro.props;
---

<section id={id} class="scroll-mt-20" aria-labelledby={`${id}-title`}>
  <div class="mx-auto max-w-3xl px-5 py-16 sm:py-20 md:px-6">
    <p class="text-xs font-medium tracking-[0.14em] text-primary uppercase">{eyebrow}</p>
    <h2 id={`${id}-title`} class="mt-3 text-4xl tracking-tight sm:text-5xl">{title}</h2>

    <div class="mt-10">
      <FaqList items={items} />
    </div>

    {
      more && (
        <a href={more.href} class="mt-8 inline-flex items-center gap-1.5 text-sm font-medium text-primary hover:underline">
          {more.label}
          <ArrowRight class="size-4" aria-hidden="true" />
        </a>
      )
    }
  </div>
</section>
