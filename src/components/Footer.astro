---
import {
  APP_LOGIN_URL,
  CONTACT_EMAIL,
  CONTACT_PHONE,
  CONTACT_PHONE_HREF,
  getLocale,
  localePath,
  t,
} from '../i18n';
import { socialLinks } from '../lib/social';
import Brand from './Brand.astro';

const locale = getLocale(Astro.currentLocale);
const copy = t(locale);
const year = new Date().getFullYear();

const columns = [
  {
    title: copy.footerBooks,
    links: [
      { href: localePath(locale, 'method'), label: copy.nav.method },
      { href: localePath(locale, 'offer'), label: copy.nav.offer },
      { href: localePath(locale, 'faq'), label: copy.nav.faq },
      { href: localePath(locale, 'contact', '?intent=devis'), label: copy.ctaQuote },
    ],
  },
  {
    title: copy.footerCompany,
    links: [
      { href: localePath(locale, 'about'), label: copy.nav.about },
      { href: localePath(locale, 'contact'), label: copy.nav.contact },
      { href: APP_LOGIN_URL, label: copy.nav.login },
    ],
  },
  {
    title: copy.footerContact,
    links: [
      { href: `mailto:${CONTACT_EMAIL}`, label: CONTACT_EMAIL },
      { href: CONTACT_PHONE_HREF, label: CONTACT_PHONE },
    ],
  },
];
---

<footer class="mt-auto border-t border-border">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 py-12 md:grid-cols-[1.4fr_1fr_1fr_1fr] md:px-6">
    <div>
      <Brand href={localePath(locale, 'home')} label={copy.homeAria} />
      <p class="mt-3 max-w-xs text-sm leading-relaxed text-muted-foreground">{copy.footerBlurb}</p>
      <ul class="mt-4 flex items-center gap-1" aria-label={copy.footerSocialAria}>
        {
          socialLinks.map((social) => (
            <li>
              <a
                href={social.href}
                class="inline-flex size-9 items-center justify-center rounded-lg text-muted-foreground transition hover:bg-muted hover:text-foreground"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={social.name}
              >
                <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d={social.path} />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    {
      columns.map((column) => (
        <div>
          <p class="text-xs font-medium tracking-wide text-muted-foreground uppercase">{column.title}</p>
          <ul class="mt-3 flex flex-col gap-2 text-sm">
            {column.links.map((link) => (
              <li>
                <a class="text-muted-foreground transition hover:text-foreground" href={link.href}>
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <div
    class="mx-auto flex max-w-6xl flex-col gap-2 border-t border-border px-5 py-4 text-xs text-muted-foreground sm:flex-row sm:items-center sm:justify-between md:px-6"
  >
    <p>© {year} Yardage. {copy.footerRights}</p>
    <div class="flex flex-wrap items-center gap-5">
      <a href={localePath(locale, 'legal')} class="hover:text-foreground">{copy.footerLegal}</a>
      <a href={localePath(locale, 'privacy')} class="hover:text-foreground">{copy.footerPrivacy}</a>
    </div>
  </div>
</footer>
