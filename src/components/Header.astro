---
import { LogIn, Menu, X } from '@lucide/astro';
import { APP_LOGIN_URL, getLocale, localePath, routeKeyFromPathname, t, type RouteKey } from '../i18n';
import Brand from './Brand.astro';
import LangSwitch from './LangSwitch.astro';
import ThemeToggle from './ThemeToggle.astro';

const locale = getLocale(Astro.currentLocale);
const copy = t(locale);
const current = routeKeyFromPathname(Astro.url.pathname);

const links: { key: RouteKey; label: string }[] = [
  { key: 'method', label: copy.nav.method },
  { key: 'offer', label: copy.nav.offer },
  { key: 'faq', label: copy.nav.faq },
  { key: 'about', label: copy.nav.about },
  { key: 'contact', label: copy.nav.contact },
];
const quoteHref = localePath(locale, 'contact', '?intent=devis');
---

<header class="sticky top-0 z-50 border-b border-border bg-background/85 backdrop-blur-xl">
  <div class="mx-auto flex h-14 max-w-6xl items-center justify-between gap-4 px-5 md:px-6">
    <Brand href={localePath(locale, 'home')} label={copy.homeAria} />

    <nav class="hidden items-center gap-6 text-sm text-muted-foreground lg:flex" aria-label={copy.navAria}>
      {
        links.map((link) => (
          <a
            href={localePath(locale, link.key)}
            class:list={[
              'transition-colors hover:text-foreground',
              current === link.key && 'font-medium text-foreground',
            ]}
            aria-current={current === link.key ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2 sm:gap-3">
      <LangSwitch />
      <ThemeToggle toDark={copy.theme.toDark} toLight={copy.theme.toLight} />
      <a
        href={APP_LOGIN_URL}
        class="hidden items-center gap-1.5 text-sm text-muted-foreground transition hover:text-foreground sm:inline-flex"
      >
        <LogIn class="size-4" aria-hidden="true" />
        {copy.nav.login}
      </a>
      <a
        href={quoteHref}
        class="hidden rounded-lg bg-primary px-3.5 py-2 text-sm font-medium text-primary-foreground shadow-sm transition hover:opacity-90 sm:inline-flex"
      >
        {copy.ctaQuote}
      </a>
      <button
        id="nav-toggle"
        type="button"
        class="inline-flex size-10 items-center justify-center rounded-lg border border-border text-foreground lg:hidden"
        aria-expanded="false"
        aria-controls="nav-panel"
        aria-label={copy.openMenu}
        data-label-open={copy.openMenu}
        data-label-close={copy.closeMenu}
      >
        <Menu id="nav-open-icon" class="size-5" aria-hidden="true" />
        <X id="nav-close-icon" class="hidden size-5" aria-hidden="true" />
      </button>
    </div>
  </div>

  <nav
    id="nav-panel"
    class="hidden border-t border-border bg-background px-5 py-4 lg:hidden"
    aria-label={copy.navMobileAria}
  >
    <div class="mx-auto flex max-w-6xl flex-col gap-1 text-base">
      {
        links.map((link) => (
          <a
            href={localePath(locale, link.key)}
            class:list={[
              'rounded-md px-2 py-2.5 hover:bg-muted hover:text-foreground',
              current === link.key ? 'font-medium text-foreground' : 'text-muted-foreground',
            ]}
            aria-current={current === link.key ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
      <a
        href={APP_LOGIN_URL}
        class="inline-flex items-center gap-2 rounded-md px-2 py-2.5 text-muted-foreground hover:bg-muted hover:text-foreground"
      >
        <LogIn class="size-4" aria-hidden="true" />
        {copy.nav.login}
      </a>
      <a
        href={quoteHref}
        class="mt-2 inline-flex justify-center rounded-lg bg-primary px-4 py-3 text-sm font-medium text-primary-foreground"
      >
        {copy.ctaQuote}
      </a>
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const panel = document.getElementById('nav-panel');
  const openIcon = document.getElementById('nav-open-icon');
  const closeIcon = document.getElementById('nav-close-icon');

  function setOpen(open: boolean) {
    panel?.classList.toggle('hidden', !open);
    openIcon?.classList.toggle('hidden', open);
    closeIcon?.classList.toggle('hidden', !open);
    toggle?.setAttribute('aria-expanded', String(open));
    const label = open ? toggle?.dataset.labelClose : toggle?.dataset.labelOpen;
    if (label) toggle?.setAttribute('aria-label', label);
  }

  toggle?.addEventListener('click', () => setOpen(panel?.classList.contains('hidden') ?? true));
  panel?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      toggle.focus();
    }
  });
</script>
