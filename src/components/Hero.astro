---
import { withBase } from '../lib/paths';
import { type Locale, localePath, t } from '../i18n';

interface Props {
  title?: string;
  headline?: string;
  subtitle?: string;
  image?: string;
  compact?: boolean;
  heading?: 'display' | 'title';
  locale?: Locale;
}

const {
  title = 'Yardage',
  image = '/images/bg-aerial.jpg',
  compact = false,
  heading = 'display',
  locale = 'fr',
} = Astro.props;

const copy = t(locale);
const subtitle = Astro.props.subtitle ?? copy.heroSubtitle;
const headline = Astro.props.headline;
const isBrand = title === 'Yardage';
---

<section
  class:list={[
    'hero-section relative isolate overflow-hidden bg-brand text-white',
    compact ? 'min-h-[44vh]' : 'min-h-[calc(100svh-3.5rem)]',
  ]}
>
  <img
    src={withBase(image)}
    alt=""
    class="animate-hero-image absolute inset-0 -z-20 h-full w-full object-cover"
    width="1600"
    height="1067"
    fetchpriority="high"
  />
  <div class="absolute inset-0 -z-10 bg-gradient-to-b from-[#0a100e]/70 via-brand/65 to-[#0a100e]/90"></div>

  <div
    class:list={[
      'mx-auto flex max-w-6xl flex-col justify-end px-5 md:px-8',
      compact ? 'pb-12 pt-20 md:pb-14 md:pt-24' : 'min-h-[calc(100svh-3.5rem)] pb-16 pt-24 md:pb-24 md:pt-32',
    ]}
  >
    {
      isBrand ? (
        headline && (
          <h1 class="animate-hero-fade max-w-3xl font-display text-3xl tracking-tight text-white md:text-5xl lg:text-6xl">
            {headline}
          </h1>
        )
      ) : (
        <h1
          class:list={[
            'animate-hero-fade font-display tracking-tight text-white',
            heading === 'title'
              ? 'max-w-4xl text-3xl md:text-5xl lg:text-6xl'
              : 'text-5xl md:text-7xl lg:text-8xl',
          ]}
        >
          {title}
        </h1>
      )
    }
    <p class="animate-hero-fade-delay mt-4 max-w-xl text-lg leading-relaxed text-white/85 md:mt-5 md:text-xl whitespace-pre-line">
      {subtitle}
    </p>
    {
      !compact && (
        <div class="animate-hero-fade-delay-2 mt-8 flex flex-wrap gap-3">
          <a
            href={localePath(locale, 'contact', '?intent=devis')}
            class="rounded-lg bg-white px-5 py-3 text-sm font-semibold text-brand transition hover:bg-white/90"
          >
            {copy.ctaQuote}
          </a>
        </div>
      )
    }
  </div>
</section>
