---
/** Top of an inner page: brand mesh, eyebrow, h1 and lead text. Extra content goes in the default slot. */
interface Props {
  eyebrow: string;
  title: string;
  text?: string;
  /** Two columns on large screens, the `aside` slot on the right. */
  split?: boolean;
}

const { eyebrow, title, text, split = false } = Astro.props;
---

<section class="relative overflow-hidden border-b border-border" aria-labelledby="page-title">
  <div class="mesh absolute inset-0"></div>
  <div class="grid-fade pointer-events-none absolute inset-0"></div>
  <div
    class:list={[
      'relative mx-auto max-w-6xl px-5 py-14 sm:py-20 md:px-6',
      split && 'grid items-center gap-12 lg:grid-cols-[1.1fr_1fr]',
    ]}
  >
    <div class="reveal">
      <p class="text-xs font-medium tracking-[0.14em] text-primary uppercase">{eyebrow}</p>
      <h1 id="page-title" class="mt-3 max-w-3xl text-5xl leading-[1.02] tracking-tight text-balance sm:text-6xl">
        {title}
      </h1>
      {text && <p class="mt-5 max-w-2xl text-lg text-pretty text-muted-foreground">{text}</p>}
      <slot />
    </div>
    {split && <div class="reveal reveal-delay-2"><slot name="aside" /></div>}
  </div>
</section>
