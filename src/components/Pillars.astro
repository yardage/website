---
import { type Locale, t } from '../lib/i18n';
import { withBase } from '../lib/paths';

interface Props {
  locale?: Locale;
}

const { locale = 'fr' } = Astro.props;
const copy = t(locale);
const pillars = copy.pillars;
---

<section class="section-photo border-b border-mist">
  <img src={withBase('/images/bg-trees.jpg')} alt="" class="section-photo-img" width="1080" height="1920" loading="lazy" />
  <div class="section-photo-veil"></div>
  <div class="mx-auto max-w-6xl px-5 py-20 md:px-8 md:py-28">
    <div class="reveal max-w-2xl">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-green-mid">{copy.pillarsEyebrow}</p>
      <h2 class="mt-3 font-display text-4xl text-ink md:text-5xl">{copy.pillarsTitle}</h2>
      <p class="mt-4 text-base leading-relaxed text-ink-soft md:text-lg">
        {copy.pillarsIntro}
      </p>
    </div>

    <ol class="reveal reveal-delay-1 mt-14 divide-y divide-mist border-y border-mist">
      {
        pillars.map((pillar, index) => (
          <li class="grid gap-3 py-7 md:grid-cols-[8rem_1fr] md:gap-10 md:py-8">
            <div class="flex items-baseline gap-3">
              <span class="font-display text-2xl text-green-mid/40">{String(index + 1).padStart(2, '0')}</span>
              <h3 class="font-display text-2xl text-green-mid md:text-3xl">{pillar.name}</h3>
            </div>
            <p class="text-base leading-relaxed text-ink-soft md:pt-1">{pillar.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
