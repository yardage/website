---
import { withBase } from '../lib/paths';
import { type Locale, t } from '../lib/i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'fr' } = Astro.props;
const copy = t(locale);

interface GalleryItem {
  src: string;
  alt: string;
  objectPosition?: string;
}

const items: GalleryItem[] = [
  {
    src: '/images/exemple-trou-1.png',
    alt: copy.gallery[0].alt,
    objectPosition: 'object-top',
  },
  {
    src: '/images/exemple-trou-2.png',
    alt: copy.gallery[1].alt,
    objectPosition: 'object-top',
  },
];
---

<div class="reveal reveal-delay-1 mt-14 grid gap-4 md:grid-cols-2 md:gap-5">
  {
    items.map((item) => (
      <button
        type="button"
        class="group relative cursor-zoom-in overflow-hidden border border-mist bg-panel/90 text-left backdrop-blur-sm"
        data-lightbox-trigger
        data-lightbox-src={withBase(item.src)}
        data-lightbox-alt={item.alt}
        aria-label={`${copy.lightboxEnlarge} : ${item.alt}`}
      >
        <img
          src={withBase(item.src)}
          alt={item.alt}
          class:list={[
            'aspect-[3/4] w-full object-contain p-3 transition duration-500 group-hover:scale-[1.02] md:p-4',
            item.objectPosition,
          ]}
          loading="lazy"
        />
      </button>
    ))
  }
</div>

<div
  id="image-lightbox"
  class="image-lightbox"
  hidden
  role="dialog"
  aria-modal="true"
  aria-label={copy.lightboxLabel}
>
  <div class="image-lightbox-backdrop" data-lightbox-close tabindex="-1"></div>

  <div class="image-lightbox-panel">
    <button
      type="button"
      class="image-lightbox-close"
      data-lightbox-close
      aria-label={copy.lightboxClose}
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>

    <button
      type="button"
      id="image-lightbox-prev"
      class="image-lightbox-nav image-lightbox-nav-prev"
      aria-label={copy.lightboxPrev}
    >
      ‹
    </button>

    <figure class="image-lightbox-figure">
      <img id="image-lightbox-img" class="image-lightbox-img" src="" alt="" />
    </figure>

    <button
      type="button"
      id="image-lightbox-next"
      class="image-lightbox-nav image-lightbox-nav-next"
      aria-label={copy.lightboxNext}
    >
      ›
    </button>

    <p id="image-lightbox-caption" class="image-lightbox-caption"></p>
  </div>
</div>

<script>
  const lightbox = document.getElementById('image-lightbox');
  const lightboxImg = document.getElementById('image-lightbox-img') as HTMLImageElement | null;
  const lightboxCaption = document.getElementById('image-lightbox-caption');
  const prevBtn = document.getElementById('image-lightbox-prev') as HTMLButtonElement | null;
  const nextBtn = document.getElementById('image-lightbox-next') as HTMLButtonElement | null;
  const closeButtons = lightbox?.querySelectorAll('[data-lightbox-close]');

  const triggers = [...document.querySelectorAll<HTMLButtonElement>('[data-lightbox-trigger]')];
  let currentIndex = 0;
  let lastFocus: HTMLElement | null = null;

  const showIndex = (index: number) => {
    const trigger = triggers[index];
    if (!lightbox || !lightboxImg || !lightboxCaption || !trigger) return;

    currentIndex = index;
    lightboxImg.src = trigger.dataset.lightboxSrc ?? '';
    lightboxImg.alt = trigger.dataset.lightboxAlt ?? '';
    lightboxCaption.textContent = `${index + 1} / ${triggers.length} — ${trigger.dataset.lightboxAlt ?? ''}`;

    if (prevBtn) prevBtn.disabled = index === 0;
    if (nextBtn) nextBtn.disabled = index === triggers.length - 1;
  };

  const openLightbox = (trigger: HTMLButtonElement) => {
    if (!lightbox) return;

    const index = triggers.indexOf(trigger);
    if (index === -1) return;

    lastFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null;
    showIndex(index);

    lightbox.hidden = false;
    document.body.classList.add('lightbox-open');

    const closeBtn = lightbox.querySelector('.image-lightbox-close');
    if (closeBtn instanceof HTMLElement) closeBtn.focus();
  };

  const closeLightbox = () => {
    if (!lightbox || !lightboxImg) return;

    lightbox.hidden = true;
    lightboxImg.src = '';
    document.body.classList.remove('lightbox-open');
    lastFocus?.focus();
    lastFocus = null;
  };

  document.addEventListener('click', (event) => {
    const trigger = (event.target as Element | null)?.closest?.('[data-lightbox-trigger]');
    if (!(trigger instanceof HTMLButtonElement)) return;

    event.preventDefault();
    openLightbox(trigger);
  });

  closeButtons?.forEach((btn) => {
    btn.addEventListener('click', closeLightbox);
  });

  prevBtn?.addEventListener('click', () => {
    if (currentIndex > 0) showIndex(currentIndex - 1);
  });

  nextBtn?.addEventListener('click', () => {
    if (currentIndex < triggers.length - 1) showIndex(currentIndex + 1);
  });

  document.addEventListener('keydown', (event) => {
    if (!lightbox || lightbox.hidden) return;

    if (event.key === 'Escape') {
      event.preventDefault();
      closeLightbox();
      return;
    }

    if (event.key === 'ArrowLeft' && currentIndex > 0) {
      event.preventDefault();
      showIndex(currentIndex - 1);
      return;
    }

    if (event.key === 'ArrowRight' && currentIndex < triggers.length - 1) {
      event.preventDefault();
      showIndex(currentIndex + 1);
    }
  });
</script>
