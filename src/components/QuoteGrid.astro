---
/**
 * Pricing block, owner rule: no price shown anywhere, quote only.
 * Left: "price on request" card with the quote button. Right: what every order includes.
 */
import { ArrowRight, Check } from '@lucide/astro';
import { getLocale, localePath, t } from '../i18n';

interface Props {
  includedTitle: string;
  included: readonly string[];
  /** Extra sentence under the "price on request" heading. */
  note?: string;
  /** Link to the offer page (home only). */
  detailLink?: boolean;
  /** Level of the two card headings (2 when the block sits right under the h1). */
  headingLevel?: 2 | 3;
}

const { includedTitle, included, note, detailLink = false, headingLevel = 3 } = Astro.props;
const Heading = headingLevel === 2 ? 'h2' : 'h3';
const locale = getLocale(Astro.currentLocale);
const copy = t(locale);
---

<div class="grid gap-4 lg:grid-cols-[1fr_1.4fr]">
  <article class="flex flex-col rounded-xl bg-primary p-6 text-primary-foreground sm:p-8">
    <p class="text-xs font-medium tracking-[0.14em] uppercase opacity-80">{copy.pricingEyebrow}</p>
    <Heading class="mt-3 font-display text-5xl leading-none tracking-tight">{copy.pricingRate}</Heading>
    <p class="mt-4 text-sm text-pretty opacity-90">{copy.pricingIntro}</p>
    {note && <p class="mt-3 text-sm text-pretty opacity-90">{note}</p>}
    <a
      href={localePath(locale, 'contact', '?intent=devis')}
      class="mt-8 inline-flex items-center justify-center gap-2 self-start rounded-lg bg-background px-5 py-3 text-sm font-medium text-foreground transition hover:opacity-90"
    >
      {copy.ctaQuote}
      <ArrowRight class="size-4" aria-hidden="true" />
    </a>
  </article>

  <article class="rounded-xl border border-border bg-card p-6 sm:p-8">
    <Heading class="font-semibold tracking-tight">{includedTitle}</Heading>
    <ul class="mt-4 grid gap-3 text-sm text-muted-foreground sm:grid-cols-2">
      {
        included.map((item) => (
          <li class="flex gap-2.5">
            <Check class="mt-0.5 size-4 shrink-0 text-primary" aria-hidden="true" />
            <span>{item}</span>
          </li>
        ))
      }
    </ul>
    {
      detailLink && (
        <a
          href={localePath(locale, 'offer')}
          class="mt-6 inline-flex items-center gap-1.5 border-t border-border pt-6 text-sm font-medium text-primary hover:underline"
        >
          {copy.pricingDetail}
          <ArrowRight class="size-4" aria-hidden="true" />
        </a>
      )
    }
  </article>
</div>
