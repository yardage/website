---
interface Props {
  eyebrow: string;
  title: string;
  text?: string;
  /** Heading id, for `aria-labelledby` on the section. */
  id?: string;
  class?: string;
}

const { eyebrow, title, text, id, class: className } = Astro.props;
---

<div class:list={['max-w-2xl', className]}>
  <p class="text-xs font-medium tracking-[0.14em] text-primary uppercase">{eyebrow}</p>
  <h2 id={id} class="mt-3 text-4xl leading-[1.05] tracking-tight text-balance sm:text-5xl">{title}</h2>
  {text && <p class="mt-4 text-pretty text-muted-foreground sm:text-lg">{text}</p>}
  <slot />
</div>
