---
/**
 * Homepage section snap: wheel / arrow keys / click jump to next block.
 * Requires [data-snap-section] on each full-page block.
 */
---

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const sections = () =>
    Array.from(document.querySelectorAll<HTMLElement>('[data-snap-section]'));

  const listInit = sections();
  if (listInit.length >= 2) {
    let locked = false;

    const easeInOutCubic = (t: number) =>
      t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;

    const duration = reduceMotion ? 0 : 750;

    const scrollToY = (targetY: number) => {
      if (duration === 0) {
        window.scrollTo({ top: targetY, behavior: 'auto' });
        locked = false;
        return;
      }
      locked = true;
      const startY = window.scrollY;
      const delta = targetY - startY;
      const start = performance.now();

      const step = (now: number) => {
        const t = Math.min(1, (now - start) / duration);
        window.scrollTo({ top: startY + delta * easeInOutCubic(t), behavior: 'auto' });
        if (t < 1) {
          requestAnimationFrame(step);
        } else {
          setTimeout(() => {
            locked = false;
          }, 120);
        }
      };
      requestAnimationFrame(step);
    };

    const sectionTop = (el: HTMLElement) =>
      el.getBoundingClientRect().top + window.scrollY;

    const currentIndex = () => {
      const list = sections();
      const y = window.scrollY + Math.min(80, window.innerHeight * 0.15);
      let idx = 0;
      for (let i = 0; i < list.length; i++) {
        if (sectionTop(list[i]) <= y + 1) idx = i;
      }
      return idx;
    };

    /** Allow native scroll inside a section taller than the viewport. */
    const canScrollInside = (el: HTMLElement, dir: 1 | -1) => {
      if (el.offsetHeight <= window.innerHeight + 4) return false;
      const rect = el.getBoundingClientRect();
      if (dir > 0) return rect.bottom > window.innerHeight + 8;
      return rect.top < -8;
    };

    const goTo = (index: number) => {
      const list = sections();
      if (index < 0 || index >= list.length) return;
      scrollToY(Math.max(0, sectionTop(list[index])));
    };

    const onWheel = (event: WheelEvent) => {
      if (document.body.classList.contains('lightbox-open')) return;
      if (locked) {
        event.preventDefault();
        return;
      }
      if (Math.abs(event.deltaY) < 4) return;

      const dir: 1 | -1 = event.deltaY > 0 ? 1 : -1;
      const list = sections();
      const idx = currentIndex();
      const current = list[idx];
      if (!current) return;

      if (canScrollInside(current, dir)) return;

      const next = idx + dir;
      if (next < 0) return;
      if (next >= list.length && dir > 0) return;

      event.preventDefault();
      goTo(next);
    };

    const onKeyDown = (event: KeyboardEvent) => {
      if (document.body.classList.contains('lightbox-open')) return;
      if (locked) {
        if (['ArrowDown', 'ArrowUp', 'PageDown', 'PageUp', ' '].includes(event.key)) {
          event.preventDefault();
        }
        return;
      }

      const tag = (event.target as HTMLElement | null)?.tagName;
      if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return;
      if ((event.target as HTMLElement | null)?.isContentEditable) return;

      let dir: 1 | -1 | 0 = 0;
      if (event.key === 'ArrowDown' || event.key === 'PageDown') dir = 1;
      if (event.key === 'ArrowUp' || event.key === 'PageUp') dir = -1;
      if (event.key === ' ' && !event.shiftKey) dir = 1;
      if (event.key === ' ' && event.shiftKey) dir = -1;
      if (!dir) return;

      const list = sections();
      const idx = currentIndex();
      const current = list[idx];
      if (!current) return;

      if (canScrollInside(current, dir)) return;

      const next = idx + dir;
      if (next < 0) return;
      if (next >= list.length && dir > 0) return;

      event.preventDefault();
      goTo(next);
    };

    const arrowSvg = `
      <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <path d="M6 10l6 6 6-6" />
      </svg>
    `;

    listInit.forEach((section, i) => {
      section.classList.add('snap-section');
      if (i >= listInit.length - 1) return;

      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'snap-next';
      btn.setAttribute('aria-label', 'Aller à la section suivante');
      btn.innerHTML = arrowSvg;
      btn.addEventListener('click', () => {
        if (locked) return;
        goTo(i + 1);
      });
      section.appendChild(btn);
    });

    window.addEventListener('wheel', onWheel, { passive: false });
    window.addEventListener('keydown', onKeyDown);
  }
</script>
