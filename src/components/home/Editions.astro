---
import { ArrowRight, BookOpen, Mountain, Trophy } from '@lucide/astro';
import { getLocale, localePath, t } from '../../i18n';
import SectionHeading from '../SectionHeading.astro';

const locale = getLocale(Astro.currentLocale);
const copy = t(locale);
const editions = copy.home.editions;
const icons = [BookOpen, Mountain, Trophy];
---

<section id={editions.id} class="section-alt scroll-mt-20 border-y border-border" aria-labelledby="editions-title">
  <div class="mx-auto max-w-6xl px-5 py-16 sm:py-20 md:px-6">
    <SectionHeading id="editions-title" eyebrow={editions.eyebrow} title={editions.title} text={editions.text} />

    <div class="mt-10 grid gap-4 md:grid-cols-3">
      {
        editions.items.map((item, index) => {
          const Icon = icons[index]!;
          return (
            <article class="flex flex-col rounded-xl border border-border bg-card p-6">
              <span class="inline-flex size-10 items-center justify-center rounded-xl bg-accent text-accent-foreground">
                <Icon class="size-5" aria-hidden="true" />
              </span>
              <h3 class="mt-4 text-sm font-semibold tracking-[0.18em]">{item.name}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{item.text}</p>
              <ul class="mt-4 space-y-2 text-sm text-muted-foreground">
                {item.points.map((point) => (
                  <li class="flex gap-2">
                    <span class="mt-2 size-1.5 shrink-0 rounded-full bg-primary" aria-hidden="true" />
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
            </article>
          );
        })
      }
    </div>

    <a
      href={localePath(locale, 'contact', '?intent=devis')}
      class="mt-8 inline-flex items-center gap-1.5 text-sm font-medium text-primary hover:underline"
    >
      {copy.ctaQuote}
      <ArrowRight class="size-4" aria-hidden="true" />
    </a>
  </div>
</section>
