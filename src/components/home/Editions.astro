---
import { ArrowRight } from '@lucide/astro';
import { Image } from 'astro:assets';
import { getLocale, localePath, t } from '../../i18n';
import { editionSamples, sampleAlt, sampleCaption } from '../../lib/bookSamples';
import SectionHeading from '../SectionHeading.astro';

const locale = getLocale(Astro.currentLocale);
const copy = t(locale);
const editions = copy.home.editions;
---

<section id={editions.id} class="section-alt scroll-mt-20 border-y border-border" aria-labelledby="editions-title">
  <div class="mx-auto max-w-6xl px-5 py-16 sm:py-20 md:px-6">
    <SectionHeading id="editions-title" eyebrow={editions.eyebrow} title={editions.title} text={editions.text} />

    <div class="mt-10 grid gap-4 md:grid-cols-3">
      {
        editions.items.map((item, index) => {
          const { sample, page } = editionSamples[index]!;
          const src = sample.pages[page];
          return (
            <article class="flex flex-col overflow-hidden rounded-xl border border-border bg-card">
              <figure class="m-0">
                <div class="aspect-[5/4] overflow-hidden border-b border-border bg-white">
                  <Image
                    src={src}
                    alt={sampleAlt(locale, sample, page)}
                    width={682}
                    widths={[360, 682]}
                    sizes="(min-width: 768px) 360px, 90vw"
                    format="webp"
                    quality={76}
                    class="block h-full w-full object-cover object-top"
                  />
                </div>
                <figcaption class="px-6 pt-3 text-xs text-muted-foreground">{sampleCaption(locale, sample)}</figcaption>
              </figure>
              <div class="flex flex-1 flex-col p-6 pt-4">
                <h3 class="text-sm font-semibold tracking-[0.18em]">{item.name}</h3>
                <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{item.text}</p>
                <ul class="mt-4 space-y-2 text-sm text-muted-foreground">
                  {item.points.map((point) => (
                    <li class="flex gap-2">
                      <span class="mt-2 size-1.5 shrink-0 rounded-full bg-primary" aria-hidden="true" />
                      <span>{point}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </article>
          );
        })
      }
    </div>

    <a
      href={localePath(locale, 'contact', '?intent=devis')}
      class="mt-8 inline-flex items-center gap-1.5 text-sm font-medium text-primary hover:underline"
    >
      {copy.ctaQuote}
      <ArrowRight class="size-4" aria-hidden="true" />
    </a>
  </div>
</section>
