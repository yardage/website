---
import { ArrowRight } from '@lucide/astro';
import { getLocale, localePath, t } from '../../i18n';
import SectionHeading from '../SectionHeading.astro';

const locale = getLocale(Astro.currentLocale);
const copy = t(locale);
---

<section aria-labelledby="flow-title">
  <div class="mx-auto max-w-6xl px-5 py-16 sm:py-20 md:px-6">
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <SectionHeading id="flow-title" eyebrow={copy.processEyebrow} title={copy.processTitle} text={copy.processIntro} />
      <a
        href={localePath(locale, 'method')}
        class="inline-flex shrink-0 items-center gap-1.5 text-sm font-medium text-primary hover:underline"
      >
        {copy.home.flow.seeMore}
        <ArrowRight class="size-4" aria-hidden="true" />
      </a>
    </div>

    <ol class="relative mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
      <span class="absolute top-9 right-8 left-8 hidden h-px bg-border lg:block" aria-hidden="true"></span>
      {
        copy.processSteps.map((step, index) => (
          <li class="relative rounded-xl border border-border bg-card p-5">
            <span class="font-display text-3xl text-primary tabular-nums">{String(index + 1).padStart(2, '0')}</span>
            <h3 class="mt-2 font-semibold tracking-tight">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{step.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
