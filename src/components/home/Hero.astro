---
import { ArrowRight } from '@lucide/astro';
import { getLocale, localePath, t } from '../../i18n';
import { sampleAlt, samples } from '../../lib/bookSamples';
import BookPage from '../BookPage.astro';

const locale = getLocale(Astro.currentLocale);
const copy = t(locale);
const hero = copy.home.hero;
// Two pages of the same validated hole, web resolution only (see AGENTS.md, visuals rule).
const spread = samples.national2;
const pages = [
  { src: spread.pages[0], alt: sampleAlt(locale, spread, 0), class: '-rotate-2' },
  { src: spread.pages[1], alt: sampleAlt(locale, spread, 1), class: 'mt-10 -ml-[7%] rotate-2 sm:mt-14' },
];
---

<section class="relative overflow-hidden" aria-labelledby="hero-title">
  <div class="mesh absolute inset-0"></div>
  <div class="grid-fade pointer-events-none absolute inset-0"></div>

  <div class="relative mx-auto max-w-6xl px-5 pt-14 pb-16 sm:pt-20 md:px-6 lg:pt-24">
    <div class="reveal mx-auto max-w-3xl text-center">
      <p
        class="inline-flex rounded-lg border border-primary/20 bg-accent px-3 py-1 text-xs font-medium tracking-[0.14em] text-accent-foreground uppercase"
      >
        {hero.eyebrow}
      </p>
      <h1 id="hero-title" class="mt-5 text-5xl leading-[1.02] tracking-tight text-balance sm:text-6xl lg:text-7xl">
        {hero.title}
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-pretty text-muted-foreground">{hero.text}</p>
      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row sm:items-center">
        <a
          href={localePath(locale, 'contact', '?intent=devis')}
          class="inline-flex items-center justify-center gap-2 rounded-lg bg-primary px-5 py-3 text-sm font-medium text-primary-foreground shadow-sm transition hover:opacity-90"
        >
          {copy.ctaQuote}
          <ArrowRight class="size-4" aria-hidden="true" />
        </a>
        <a
          href={`#${copy.home.editions.id}`}
          class="inline-flex items-center justify-center rounded-lg border border-border bg-card px-5 py-3 text-sm font-medium transition hover:bg-muted"
        >
          {hero.secondary}
        </a>
      </div>
      <ul class="mt-8 flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm text-muted-foreground">
        {
          hero.facts.map((fact) => (
            <li class="inline-flex items-center gap-2">
              <span class="size-1.5 rounded-full bg-primary" aria-hidden="true" />
              {fact}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="reveal reveal-delay-2 relative mx-auto mt-14 max-w-3xl sm:mt-16">
      <div class="absolute inset-x-[8%] inset-y-[10%] -z-10 rounded-[3rem] bg-primary/20 blur-3xl dark:bg-primary/15"></div>
      <div class="flex justify-center">
        {
          pages.map((page) => (
            <BookPage
              src={page.src}
              alt={page.alt}
              sizes="(min-width: 768px) 352px, 46vw"
              priority
              class={`w-[46%] max-w-[22rem] ${page.class}`}
            />
          ))
        }
      </div>
    </div>
  </div>
</section>
