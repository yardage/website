---
import { ArrowRight, Check } from '@lucide/astro';
import { getLocale, localePath, t } from '../../i18n';
import SectionHeading from '../SectionHeading.astro';

const locale = getLocale(Astro.currentLocale);
const copy = t(locale);
---

<section id="tarifs" class="section-alt scroll-mt-20 border-y border-border" aria-labelledby="pricing-title">
  <div class="mx-auto max-w-6xl px-5 py-16 sm:py-20 md:px-6">
    <SectionHeading id="pricing-title" eyebrow={copy.pricingEyebrow} title={copy.pricingTitle}>
      <p class="mt-4 text-pretty text-muted-foreground sm:text-lg">
        {copy.pricingIntroBefore}{' '}
        <strong class="font-semibold text-foreground">{copy.pricingIntroPrice}</strong>{copy.pricingIntroAfter}
      </p>
    </SectionHeading>

    <div class="mt-10 grid gap-4 md:grid-cols-3">
      {
        copy.pricingVolumes.map((tier) => (
          <article
            class="rounded-xl border border-border bg-card p-6"
          >
            <h3 class="text-xs font-medium tracking-[0.14em] text-muted-foreground uppercase">{tier.qty}</h3>
            <p class="mt-4 font-display text-5xl tracking-tight text-primary">{tier.price}</p>
            <p class="mt-2 text-sm text-muted-foreground">{tier.note}</p>
          </article>
        ))
      }
    </div>

    <div class="mt-4 rounded-xl border border-border bg-card p-6 sm:p-8">
      <h3 class="font-semibold tracking-tight">{copy.home.pricing.included}</h3>
      <ul class="mt-4 grid gap-3 text-sm text-muted-foreground sm:grid-cols-2">
        {
          copy.pricingExtras.map((item) => (
            <li class="flex gap-2.5">
              <Check class="mt-0.5 size-4 shrink-0 text-primary" aria-hidden="true" />
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
      <div class="mt-6 flex flex-col gap-3 border-t border-border pt-6 sm:flex-row sm:items-center sm:gap-6">
        <a
          href={localePath(locale, 'contact', '?intent=devis')}
          class="inline-flex items-center justify-center gap-2 rounded-lg bg-primary px-5 py-3 text-sm font-medium text-primary-foreground shadow-sm transition hover:opacity-90"
        >
          {copy.ctaQuote}
          <ArrowRight class="size-4" aria-hidden="true" />
        </a>
        <a href={localePath(locale, 'offer')} class="inline-flex items-center gap-1.5 text-sm font-medium text-primary hover:underline">
          {copy.pricingDetail}
          <ArrowRight class="size-4" aria-hidden="true" />
        </a>
      </div>
    </div>
  </div>
</section>
