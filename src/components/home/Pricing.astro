---
import { getLocale, t } from '../../i18n';
import QuoteGrid from '../QuoteGrid.astro';
import SectionHeading from '../SectionHeading.astro';

const copy = t(getLocale(Astro.currentLocale));
---

<section id="tarifs" class="section-alt scroll-mt-20 border-y border-border" aria-labelledby="pricing-title">
  <div class="mx-auto max-w-6xl px-5 py-16 sm:py-20 md:px-6">
    <SectionHeading id="pricing-title" eyebrow={copy.pricingEyebrow} title={copy.pricingTitle} />
    <div class="mt-10">
      <QuoteGrid includedTitle={copy.home.pricing.included} included={copy.pricingExtras} detailLink />
    </div>
  </div>
</section>
