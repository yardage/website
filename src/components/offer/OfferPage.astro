---
/** The offer page, shared by `/offre/` and `/en/offer/`. Prices and conditions come from i18n. */
import { FileText } from '@lucide/astro';
import cover from '../../assets/carnets/couverture-ableiges.jpg';
import { absoluteUrl, getLocale, localePath, t } from '../../i18n';
import Base from '../../layouts/Base.astro';
import { breadcrumbJsonLd, faqPageJsonLd } from '../../lib/schema';
import BookPage from '../BookPage.astro';
import Cta from '../Cta.astro';
import Faq from '../Faq.astro';
import Footer from '../Footer.astro';
import Header from '../Header.astro';
import Editions from '../home/Editions.astro';
import PageHero from '../PageHero.astro';
import QuoteGrid from '../QuoteGrid.astro';
import SectionHeading from '../SectionHeading.astro';

const locale = getLocale(Astro.currentLocale);
const copy = t(locale);
const offer = copy.offer;
const faqItems = offer.faqItems.map((index) => copy.faq.items[index]!);
---

<Base
  title={offer.title}
  description={offer.description}
  jsonLd={[
    breadcrumbJsonLd([
      { name: copy.breadcrumbHome, url: absoluteUrl(locale, 'home') },
      { name: copy.nav.offer, url: absoluteUrl(locale, 'offer') },
    ]),
    faqPageJsonLd(faqItems.map((item) => ({ question: item.q, answer: item.a }))),
  ]}
>
  <Header />
  <main id="main">
    <PageHero eyebrow={offer.eyebrow} title={copy.pricingTitle} text={offer.text}>
      <div class="mt-12">
        <QuoteGrid includedTitle={offer.includedTitle} included={offer.included} note={offer.includedText} headingLevel={2} />
      </div>
    </PageHero>

    <Editions />

    <section aria-labelledby="custom-title">
      <div class="mx-auto grid max-w-6xl items-center gap-12 px-5 py-16 sm:py-20 md:px-6 lg:grid-cols-[1.2fr_1fr]">
        <div>
          <SectionHeading id="custom-title" eyebrow={offer.custom.eyebrow} title={offer.custom.title} />
          {offer.custom.paragraphs.map((paragraph) => <p class="mt-4 max-w-xl text-pretty text-muted-foreground">{paragraph}</p>)}
          <a
            href="/docs/exemple-couverture.pdf"
            class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-primary hover:underline"
            type="application/pdf"
          >
            <FileText class="size-4" aria-hidden="true" />
            {copy.coverPdf}
          </a>
        </div>
        <div class="relative mx-auto w-full max-w-xs">
          <div class="absolute inset-[8%] -z-10 rounded-[2rem] bg-primary/20 blur-3xl dark:bg-primary/15"></div>
          <BookPage src={cover} alt={offer.custom.coverAlt} sizes="(min-width: 1024px) 320px, 80vw" class="rotate-1" />
        </div>
      </div>
    </section>

    <section class="section-alt border-y border-border" aria-labelledby="process-title">
      <div class="mx-auto max-w-6xl px-5 py-16 sm:py-20 md:px-6">
        <SectionHeading
          id="process-title"
          eyebrow={offer.process.eyebrow}
          title={offer.process.title}
          text={offer.process.text}
        />
        <ol class="relative mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
          <span class="absolute top-9 right-8 left-8 hidden h-px bg-border lg:block" aria-hidden="true"></span>
          {
            offer.process.steps.map((step, index) => (
              <li class="relative rounded-xl border border-border bg-card p-5">
                <span class="font-display text-3xl text-primary tabular-nums">{String(index + 1).padStart(2, '0')}</span>
                <h3 class="mt-2 font-semibold tracking-tight">{step.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{step.text}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <Faq
      eyebrow={copy.faq.eyebrow}
      title={copy.faq.title}
      items={faqItems}
      more={{ href: localePath(locale, 'faq'), label: copy.home.faq.seeAll }}
    />
    <Cta
      eyebrow={offer.cta.eyebrow}
      title={offer.cta.title}
      text={offer.cta.text}
      secondary={{ href: localePath(locale, 'method'), label: copy.home.flow.seeMore }}
    />
  </main>
  <Footer />
</Base>
