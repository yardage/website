---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Hero from '../../components/Hero.astro';
import Pillars from '../../components/Pillars.astro';
import ProcessSteps from '../../components/ProcessSteps.astro';
import ProductGallery from '../../components/ProductGallery.astro';
import SectionPhoto from '../../components/SectionPhoto.astro';
import { localePath, t } from '../../lib/i18n';

const locale = 'en' as const;
const copy = t(locale);
---

<BaseLayout
  locale={locale}
  title="Home — Yardage"
  description="Yardage designs and produces golf yardage books for clubs and professionals. Cartographic precision, premium print, tailored quotes."
  ogImage="/images/bg-aerial.jpg"
>
  <Header locale={locale} />
  <main>
    <Hero locale={locale} image="/images/bg-aerial.jpg" headline={copy.heroHeadline} />
    <Pillars locale={locale} />

    <SectionPhoto
      id="produit"
      image="/images/carnets-irl_2.jpg"
      imgClass="!opacity-30"
      contentClass="mx-auto max-w-6xl px-5 py-20 md:px-8 md:py-28"
    >
      <div class="reveal max-w-2xl">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-green-mid">The product</p>
        <h2 class="mt-3 font-display text-4xl text-ink md:text-5xl">From course design to printed book.</h2>
        <p class="mt-4 text-base leading-relaxed text-ink-soft md:text-lg">
          Custom cover, precise mapping, a format built for the course. A book designed for clubs
          and pros, for directors, managers and decision-making staff.
        </p>
      </div>

      <ProductGallery locale={locale} />
    </SectionPhoto>

    <ProcessSteps teaser locale={locale} />

    <SectionPhoto
      image="/images/bg-fairway1.jpg"
      contentClass="mx-auto max-w-6xl px-5 py-20 md:px-8 md:py-28"
    >
      <h2 class="reveal max-w-xl font-display text-4xl text-ink md:text-5xl">
        A book worthy of your course.
      </h2>
      <p class="reveal reveal-delay-1 mt-4 max-w-lg text-base leading-relaxed text-ink-soft md:text-lg">
        Request a quote on behalf of your club. If you are a player, speak to your director or
        manager: they are the ones who can make the request.
      </p>
      <div class="reveal reveal-delay-2 mt-8 flex flex-wrap gap-3">
        <a
          href={localePath(locale, 'contact', '?intent=devis')}
          class="rounded-sm bg-white px-5 py-3 text-sm font-semibold text-brand transition hover:bg-ink"
        >
          Request a quote
        </a>
      </div>
    </SectionPhoto>
  </main>
  <Footer locale={locale} />
</BaseLayout>
