---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Hero from '../../components/Hero.astro';
import Pillars from '../../components/Pillars.astro';
import ProcessSteps from '../../components/ProcessSteps.astro';
import ProductGallery from '../../components/ProductGallery.astro';
import { withBase } from '../../lib/paths';
import { localePath } from '../../lib/i18n';

const locale = 'en' as const;
---

<BaseLayout
  locale={locale}
  title="Yardage — Yardage books for golf clubs and pros"
  description="Yardage designs and produces golf yardage books for clubs and professionals. Cartographic precision, premium print, tailored quotes."
  ogImage="/images/bg-aerial.jpg"
>
  <Header locale={locale} />
  <main>
    <Hero locale={locale} />
    <Pillars locale={locale} />

    <section class="section-photo border-b border-mist" id="produit">
      <img
        src={withBase('/images/carnets-irl.jpg')}
        alt=""
        class="section-photo-img !opacity-30"
        width="823"
        height="795"
        loading="lazy"
      />
      <div class="section-photo-veil"></div>
      <div class="mx-auto max-w-6xl px-5 py-20 md:px-8 md:py-28">
        <div class="reveal max-w-2xl">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-green-mid">The product</p>
          <h2 class="mt-3 font-display text-4xl text-ink md:text-5xl">From course design to printed book.</h2>
          <p class="mt-4 text-base leading-relaxed text-ink-soft md:text-lg">
            Custom cover, precise mapping, a format built for the course. Request a
            <span class="text-ink">free digital sample</span> to discover your golf club.
          </p>
        </div>

        <ProductGallery locale={locale} />
      </div>
    </section>

    <ProcessSteps teaser locale={locale} />

    <section class="relative isolate overflow-hidden text-white">
      <img
        src={withBase('/images/bg-fairway.jpg')}
        alt=""
        class="absolute inset-0 -z-20 h-full w-full object-cover"
        width="1280"
        height="1920"
        loading="lazy"
      />
      <div class="absolute inset-0 -z-10 bg-paper/80"></div>
      <div class="reveal mx-auto max-w-6xl px-5 py-20 md:px-8 md:py-28">
        <h2 class="max-w-xl font-display text-4xl md:text-5xl">
          A book worthy of your course.
        </h2>
        <p class="mt-4 max-w-lg text-base leading-relaxed text-white/80 md:text-lg">
          Request a quote or a free digital sample — we review your club and propose a production that fits.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href={localePath(locale, 'contact', '?intent=devis')}
            class="rounded-sm bg-white px-5 py-3 text-sm font-semibold text-brand transition hover:bg-ink"
          >
            Request a quote
          </a>
          <a
            href={localePath(locale, 'contact', '?intent=exemplaire#exemplaire')}
            class="rounded-sm border border-white/35 px-5 py-3 text-sm font-semibold text-white transition hover:bg-white/10"
          >
            Free digital sample
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer locale={locale} />
</BaseLayout>
