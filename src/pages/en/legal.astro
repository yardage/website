---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Hero from '../../components/Hero.astro';

const locale = 'en' as const;
---

<BaseLayout
  locale={locale}
  title="Legal notice — Yardage"
  description="Legal notice for Yardage and yardage.io website."
>
  <Header locale={locale} />
  <main>
    <Hero
      locale={locale}
      title="Legal notice"
      subtitle="Legal information relating to Yardage and yardage.io website."
      compact
    />
    <section class="bg-paper">
      <div class="reveal prose-legal mx-auto max-w-3xl px-5 py-16 md:px-8 md:py-20">
        <h2 class="font-display text-2xl text-ink">Publisher</h2>
        <p class="mt-3 text-base leading-relaxed text-ink-soft">
          The website <strong>yardage.io</strong> is published under the Yardage brand.<br />
          Contact: <a href="mailto:contact@yardage.co" class="text-green-mid hover:underline">contact@yardage.co</a>
          — <a href="tel:+33537079718" class="text-green-mid hover:underline">+33 5 37 07 97 18</a>.
        </p>

        <h2 class="mt-10 font-display text-2xl text-ink">Billing</h2>
        <p class="mt-3 text-base leading-relaxed text-ink-soft">
          Yardage products are invoiced by <strong>PLATEFORME IO</strong>, a French SAS with share capital of €1,000.<br />
          Registered office: 128 rue La Boétie, 75008 Paris, France.<br />
          SIREN: 842 499 808 — SIRET: 842 499 808 00017.
        </p>
        <p class="mt-3 text-base leading-relaxed text-ink-soft">
          For any commercial enquiry: <a href="mailto:contact@yardage.co" class="text-green-mid hover:underline">contact@yardage.co</a>
          — <a href="tel:+33537079718" class="text-green-mid hover:underline">+33 5 37 07 97 18</a>.
        </p>

        <h2 class="mt-10 font-display text-2xl text-ink">Hosting</h2>
        <p class="mt-3 text-base leading-relaxed text-ink-soft">
          The site is hosted by <strong>Amazon Web Services EMEA SARL</strong>, 38 Avenue John F. Kennedy, L-1855 Luxembourg.
          RCS Luxembourg B186284.
        </p>

        <h2 class="mt-10 font-display text-2xl text-ink">Intellectual property</h2>
        <p class="mt-3 text-base leading-relaxed text-ink-soft">
          <strong>Yardage</strong> is a registered trademark. All content on this site (text, visuals,
          logos, videos) is protected. Unauthorised reproduction is prohibited.
        </p>
        <p class="mt-3 text-base leading-relaxed text-ink-soft">
          Reproduction of all Yardage products and associated development tools is prohibited without
          prior authorisation.
        </p>
      </div>
    </section>
  </main>
  <Footer locale={locale} />
</BaseLayout>
