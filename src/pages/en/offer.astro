---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Hero from '../../components/Hero.astro';
import Pricing from '../../components/Pricing.astro';
import ProductGallery from '../../components/ProductGallery.astro';
import SectionPhoto from '../../components/SectionPhoto.astro';

const locale = 'en' as const;
---

<BaseLayout
  locale={locale}
  title="Offer — Yardage"
  description="Yardage pricing: club rate on request, volume discounts, 150-copy minimum, delivery within 1 month after quote approval."
>
  <Header locale={locale} />
  <main>
    <Hero
      locale={locale}
      title="Offer"
      subtitle="Customisation, eco-friendly paper, delivery within 1 month after quote approval — from 150 copies."
      image="/images/bg-water.jpg"
      compact
    />

    <SectionPhoto contentClass="mx-auto max-w-3xl px-5 py-16 md:px-8 md:py-20">
      <h2 class="reveal font-display text-2xl text-ink md:text-3xl">What’s included</h2>
      <p class="reveal reveal-delay-1 mt-4 text-base leading-relaxed text-ink-soft">
        The club rate covers the full journey, from design to delivery. You do not need to assemble
        vendors: Yardage handles the product end to end.
      </p>
      <p class="reveal reveal-delay-2 mt-4 text-base leading-relaxed text-ink-soft">
        Every order includes customisation of your identity — club logo, sponsor page, partner
        mentions — so the book clearly carries your brand.
      </p>
      <p class="reveal reveal-delay-3 mt-4 text-base leading-relaxed text-ink-soft">
        Printing is done on eco-friendly paper, with premium finishes suited to the pro shop and to
        course use. Delivery is handled through to your club, within
        <span class="font-semibold text-ink">1 month</span> after quote approval.
      </p>
      <p class="reveal reveal-delay-4 mt-4 text-base leading-relaxed text-ink-soft">
        Minimum order: <span class="font-semibold text-ink">150 copies</span>. A digital sample can
        be prepared on request.
      </p>
    </SectionPhoto>

    <SectionPhoto
      image="/images/carnets-irl_3.jpg"
      imgClass="!opacity-30"
      contentClass="mx-auto max-w-6xl px-5 py-20 md:px-8 md:py-28"
    >
      <div class="reveal max-w-2xl">
        <h2 class="font-display text-3xl text-ink md:text-4xl">Customisation</h2>
        <p class="mt-4 text-base leading-relaxed text-ink-soft md:text-lg">
          Club logo, sponsor page, partner mentions — the book carries your organisation’s identity
          while remaining a playing tool.
        </p>
        <p class="mt-4 text-base leading-relaxed text-ink-soft md:text-lg">
          We adapt the cover and brand elements to your guidelines without compromising the
          readability of hole pages. The result should be immediately recognisable as your club’s
          official yardage book.
        </p>
      </div>

      <ProductGallery locale={locale} />
    </SectionPhoto>

    <SectionPhoto contentClass="mx-auto max-w-3xl px-5 py-16 md:px-8 md:py-20">
      <h2 class="reveal font-display text-2xl text-ink md:text-3xl">How it works</h2>
      <p class="reveal reveal-delay-1 mt-4 text-base leading-relaxed text-ink-soft">
        The commercial path is intentionally simple. You keep control of approval; we handle
        production.
      </p>
      <ol class="mt-8 space-y-6">
        <li class="reveal grid gap-2 md:grid-cols-[4rem_1fr] md:gap-6">
          <span class="font-display text-3xl text-green-mid/40">01</span>
          <div>
            <h3 class="font-display text-xl text-green-mid">Contact</h3>
            <p class="mt-2 text-base leading-relaxed text-ink-soft">
              The club writes to us with the club name, number of holes and, if possible, an
              estimated volume — from 150 copies.
            </p>
          </div>
        </li>
        <li class="reveal reveal-delay-1 grid gap-2 md:grid-cols-[4rem_1fr] md:gap-6">
          <span class="font-display text-3xl text-green-mid/40">02</span>
          <div>
            <h3 class="font-display text-xl text-green-mid">Quote</h3>
            <p class="mt-2 text-base leading-relaxed text-ink-soft">
              We review your course and send a clear proposal: pricing, customisation options and
              delivery terms.
            </p>
          </div>
        </li>
        <li class="reveal reveal-delay-2 grid gap-2 md:grid-cols-[4rem_1fr] md:gap-6">
          <span class="font-display text-3xl text-green-mid/40">03</span>
          <div>
            <h3 class="font-display text-xl text-green-mid">Approval</h3>
            <p class="mt-2 text-base leading-relaxed text-ink-soft">
              Once the quote is approved, production starts. You validate identity elements (logo,
              sponsors) so the book matches your image.
            </p>
          </div>
        </li>
        <li class="reveal reveal-delay-3 grid gap-2 md:grid-cols-[4rem_1fr] md:gap-6">
          <span class="font-display text-3xl text-green-mid/40">04</span>
          <div>
            <h3 class="font-display text-xl text-green-mid">Delivery</h3>
            <p class="mt-2 text-base leading-relaxed text-ink-soft">
              Books are delivered within <span class="font-semibold text-ink">1 month</span> after
              quote approval — ready for the pro shop, members and competitions.
            </p>
          </div>
        </li>
      </ol>
    </SectionPhoto>

    <Pricing locale={locale} />
  </main>
  <Footer locale={locale} />
</BaseLayout>
