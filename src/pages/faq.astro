---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import SectionPhoto from '../components/SectionPhoto.astro';
import { localePath, routes, t } from '../i18n';
import { SITE_URL, breadcrumbJsonLd, faqPageJsonLd } from '../lib/schema';

const locale = 'fr' as const;
const pageUrl = `${SITE_URL}${routes.faq.fr}`;

const faqs = t(locale).faq.items.map((item) => ({ question: item.q, answer: item.a }));
---

<Base
  title="FAQ — Yardage"
  description="Réponses sur les carnets de parcours golf Yardage : contenu d’une page, tarifs, délais, personnalisation, télémètre et commande club."
  jsonLd={[
    faqPageJsonLd(faqs),
    breadcrumbJsonLd([
      { name: 'Accueil', url: `${SITE_URL}/` },
      { name: 'FAQ', url: pageUrl },
    ]),
  ]}
>
  <Header />
  <main id="main">
    <Hero
      locale={locale}
      title="FAQ"
      subtitle="Questions fréquentes sur les carnets de parcours golf Yardage — pour les clubs et les joueurs."
      image="/images/bg-green1.jpg"
      compact
    />

    <SectionPhoto contentClass="mx-auto max-w-3xl px-5 py-16 md:px-8 md:py-20">
      <div class="space-y-12">
        {
          faqs.map((item) => (
            <div class="reveal">
              <h2 class="font-display text-2xl text-ink md:text-3xl">{item.question}</h2>
              <p class="mt-4 text-base leading-relaxed text-ink-soft">{item.answer}</p>
            </div>
          ))
        }
      </div>

      <div class="reveal mt-14 flex flex-wrap gap-3">
        <a
          href={localePath(locale, 'contact', '?intent=devis')}
          class="inline-flex rounded-lg bg-primary px-5 py-3 text-sm font-semibold text-primary-foreground transition hover:opacity-90"
        >
          Demander un devis
        </a>
        <a
          href={localePath(locale, 'method')}
          class="inline-flex rounded-lg border border-border px-5 py-3 text-sm font-semibold text-foreground transition hover:bg-muted"
        >
          Voir la méthode
        </a>
      </div>
    </SectionPhoto>
  </main>
  <Footer />
</Base>
