---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import Pillars from '../components/Pillars.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import ProductGallery from '../components/ProductGallery.astro';
import SectionPhoto from '../components/SectionPhoto.astro';
import { localePath } from '../lib/i18n';

const locale = 'fr' as const;
---

<BaseLayout
  locale={locale}
  title="Yardage — Carnets de parcours pour golfs et pros"
  description="Yardage conçoit et produit des carnets de parcours golf pour clubs et professionnels. Précision cartographique, impression premium, devis sur mesure."
  ogImage="/images/bg-aerial.jpg"
>
  <Header locale={locale} />
  <main>
    <Hero locale={locale} image="/images/bg-aerial.jpg" />
    <Pillars locale={locale} />

    <SectionPhoto
      id="produit"
      image="/images/carnets-irl_2.jpg"
      imgClass="!opacity-30"
      contentClass="mx-auto max-w-6xl px-5 py-20 md:px-8 md:py-28"
    >
      <div class="reveal max-w-2xl">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-green-mid">Le produit</p>
        <h2 class="mt-3 font-display text-4xl text-ink md:text-5xl">Du dessin du parcours au carnet imprimé.</h2>
        <p class="mt-4 text-base leading-relaxed text-ink-soft md:text-lg">
          Couverture personnalisée, cartographie précise, format pensé pour le parcours. Un carnet
          conçu pour les golfs et les pros, à l’attention des directeurs, gérants et salariés
          décisionnaires.
        </p>
      </div>

      <ProductGallery locale={locale} />
    </SectionPhoto>

    <ProcessSteps teaser locale={locale} />

    <SectionPhoto
      image="/images/bg-fairway1.jpg"
      contentClass="mx-auto max-w-6xl px-5 py-20 md:px-8 md:py-28"
    >
      <h2 class="reveal max-w-xl font-display text-4xl text-ink md:text-5xl">
        Un carnet digne de votre parcours.
      </h2>
      <p class="reveal reveal-delay-1 mt-4 max-w-lg text-base leading-relaxed text-ink-soft md:text-lg">
        Demandez un devis au nom de votre golf. Si vous êtes joueur, parlez-en au directeur ou au
        gérant : c’est à eux d’effectuer la demande.
      </p>
      <div class="reveal reveal-delay-2 mt-8 flex flex-wrap gap-3">
        <a
          href={localePath(locale, 'contact', '?intent=devis')}
          class="rounded-sm bg-white px-5 py-3 text-sm font-semibold text-brand transition hover:bg-ink"
        >
          Demander un devis
        </a>
      </div>
    </SectionPhoto>
  </main>
  <Footer locale={locale} />
</BaseLayout>
