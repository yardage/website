---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';

const locale = 'fr' as const;
---

<BaseLayout
  locale={locale}
  title="Mentions légales — Yardage"
  description="Mentions légales du site Yardage."
>
  <Header locale={locale} />
  <main>
    <Hero
      locale={locale}
      title="Mentions légales"
      subtitle="Informations légales relatives à Yardage et au site yardage.io."
      compact
    />
    <section class="bg-paper">
      <div class="reveal prose-legal mx-auto max-w-3xl px-5 py-16 md:px-8 md:py-20">
        <h2 class="font-display text-2xl text-ink">Éditeur</h2>
        <p class="mt-3 text-base leading-relaxed text-ink-soft">
          Le site <strong>yardage.io</strong> est édité sous la marque Yardage.<br />
          Contact : <a href="mailto:contact@yardage.co" class="text-green-mid hover:underline">contact@yardage.co</a>
          — <a href="tel:+33537079718" class="text-green-mid hover:underline">+33 5 37 07 97 18</a>.
        </p>

        <h2 class="mt-10 font-display text-2xl text-ink">Facturation</h2>
        <p class="mt-3 text-base leading-relaxed text-ink-soft">
          Les produits Yardage sont facturés par <strong>PLATEFORME IO</strong>, SAS au capital de 1&nbsp;000&nbsp;€.<br />
          Siège social : 128 rue La Boétie, 75008 Paris.<br />
          SIREN : 842 499 808 — SIRET : 842 499 808 00017.
        </p>
        <p class="mt-3 text-base leading-relaxed text-ink-soft">
          Pour toute demande commerciale : <a href="mailto:contact@yardage.co" class="text-green-mid hover:underline">contact@yardage.co</a>
          — <a href="tel:+33537079718" class="text-green-mid hover:underline">+33 5 37 07 97 18</a>.
        </p>

        <h2 class="mt-10 font-display text-2xl text-ink">Hébergement</h2>
        <p class="mt-3 text-base leading-relaxed text-ink-soft">
          Le site est hébergé par <strong>Amazon Web Services EMEA SARL</strong>, 38 Avenue John F. Kennedy, L-1855 Luxembourg.
          RCS Luxembourg B186284.
        </p>

        <h2 class="mt-10 font-display text-2xl text-ink">Propriété intellectuelle</h2>
        <p class="mt-3 text-base leading-relaxed text-ink-soft">
          <strong>Yardage</strong> est une marque déposée. L’ensemble des contenus présents sur ce site (textes, visuels,
          logos, vidéos) est protégé. Toute reproduction non autorisée est interdite.
        </p>
        <p class="mt-3 text-base leading-relaxed text-ink-soft">
          La reproduction de tous les produits Yardage et des outils de développement associés est interdite sans
          autorisation préalable.
        </p>
      </div>
    </section>
  </main>
  <Footer locale={locale} />
</BaseLayout>
