---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import Pricing from '../components/Pricing.astro';
import ProductGallery from '../components/ProductGallery.astro';
import SectionPhoto from '../components/SectionPhoto.astro';

const locale = 'fr' as const;
---

<BaseLayout
  locale={locale}
  title="Offre — Yardage"
  description="Tarifs Yardage : tarif club sur devis, remises volume, minimum 150 exemplaires, livraison sous 1 mois après validation du devis."
>
  <Header locale={locale} />
  <main>
    <Hero
      locale={locale}
      title="Offre"
      subtitle="Personnalisation, papier écologique, livraison sous 1 mois après validation du devis — à partir de 150 exemplaires."
      image="/images/bg-water.jpg"
      compact
    />

    <SectionPhoto contentClass="mx-auto max-w-3xl px-5 py-16 md:px-8 md:py-20">
      <h2 class="reveal font-display text-2xl text-ink md:text-3xl">Ce qui est inclus</h2>
      <p class="reveal reveal-delay-1 mt-4 text-base leading-relaxed text-ink-soft">
        Le tarif club couvre l’ensemble du parcours, de la conception à la livraison. Vous n’avez pas à
        assembler des prestataires : Yardage prend en charge le produit de bout en bout.
      </p>
      <p class="reveal reveal-delay-2 mt-4 text-base leading-relaxed text-ink-soft">
        Chaque commande inclut la personnalisation de votre identité — logo du club, page sponsors,
        mentions partenaires — pour que le carnet porte clairement votre marque.
      </p>
      <p class="reveal reveal-delay-3 mt-4 text-base leading-relaxed text-ink-soft">
        L’impression est réalisée sur papier écologique, avec des finitions premium adaptées au pro
        shop et à l’usage sur le parcours. La livraison est assurée jusqu’à votre structure,
        <span class="font-semibold text-ink">sous 1 mois</span> après validation du devis.
      </p>
      <p class="reveal reveal-delay-4 mt-4 text-base leading-relaxed text-ink-soft">
        Commande minimale : <span class="font-semibold text-ink">150 exemplaires</span>. Un exemplaire
        numérique peut être préparé sur demande.
      </p>
    </SectionPhoto>

    <SectionPhoto
      image="/images/carnets-irl_3.jpg"
      imgClass="!opacity-30"
      contentClass="mx-auto max-w-6xl px-5 py-20 md:px-8 md:py-28"
    >
      <div class="reveal max-w-2xl">
        <h2 class="font-display text-3xl text-ink md:text-4xl">Personnalisation</h2>
        <p class="mt-4 text-base leading-relaxed text-ink-soft md:text-lg">
          Logo du club, page sponsors, mentions partenaires — le carnet porte l’identité de votre
          structure tout en restant un outil de jeu.
        </p>
        <p class="mt-4 text-base leading-relaxed text-ink-soft md:text-lg">
          Nous adaptons la couverture et les éléments de marque à votre charte, sans compromettre la
          lisibilité des pages de trou. Le résultat doit être immédiatement reconnaissable comme le
          carnet officiel de votre golf.
        </p>
      </div>

      <ProductGallery locale={locale} />
    </SectionPhoto>

    <SectionPhoto contentClass="mx-auto max-w-3xl px-5 py-16 md:px-8 md:py-20">
      <h2 class="reveal font-display text-2xl text-ink md:text-3xl">Comment ça se passe</h2>
      <p class="reveal reveal-delay-1 mt-4 text-base leading-relaxed text-ink-soft">
        Le parcours commercial est volontairement simple. Vous gardez la main sur la validation ; nous
        assurons la production.
      </p>
      <ol class="mt-8 space-y-6">
        <li class="reveal grid gap-2 md:grid-cols-[4rem_1fr] md:gap-6">
          <span class="font-display text-3xl text-green-mid/40">01</span>
          <div>
            <h3 class="font-display text-xl text-green-mid">Contact</h3>
            <p class="mt-2 text-base leading-relaxed text-ink-soft">
              Le golf nous écrit avec le nom du club, le nombre de trous et, si possible, un volume
              estimé — à partir de 150 exemplaires.
            </p>
          </div>
        </li>
        <li class="reveal reveal-delay-1 grid gap-2 md:grid-cols-[4rem_1fr] md:gap-6">
          <span class="font-display text-3xl text-green-mid/40">02</span>
          <div>
            <h3 class="font-display text-xl text-green-mid">Devis</h3>
            <p class="mt-2 text-base leading-relaxed text-ink-soft">
              Nous étudions votre parcours et vous adressons une proposition claire : tarif, options
              de personnalisation et modalités de livraison.
            </p>
          </div>
        </li>
        <li class="reveal reveal-delay-2 grid gap-2 md:grid-cols-[4rem_1fr] md:gap-6">
          <span class="font-display text-3xl text-green-mid/40">03</span>
          <div>
            <h3 class="font-display text-xl text-green-mid">Validation</h3>
            <p class="mt-2 text-base leading-relaxed text-ink-soft">
              Une fois le devis validé, la production démarre. Vous validez les éléments d’identité
              (logo, sponsors) pour que le carnet soit à votre image.
            </p>
          </div>
        </li>
        <li class="reveal reveal-delay-3 grid gap-2 md:grid-cols-[4rem_1fr] md:gap-6">
          <span class="font-display text-3xl text-green-mid/40">04</span>
          <div>
            <h3 class="font-display text-xl text-green-mid">Livraison</h3>
            <p class="mt-2 text-base leading-relaxed text-ink-soft">
              Les carnets vous sont livrés sous <span class="font-semibold text-ink">1 mois</span>
              après validation du devis — prêts pour le pro shop, les membres et les compétitions.
            </p>
          </div>
        </li>
      </ol>
    </SectionPhoto>

    <Pricing locale={locale} />
  </main>
  <Footer locale={locale} />
</BaseLayout>
